{
  "name": "@goobits/blog-theme-miko",
  "version": "0.1.0",
  "description": "Miko presentation layer for @goobits/blog",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "svelte": "./src/components/*",
      "default": "./src/components/*"
    },
    "./utils/*": {
      "svelte": "./src/utils/*",
      "default": "./src/utils/*"
    }
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@goobits/blog": "workspace:*",
    "@goobits/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.60.1"
  }
}
