{
  "name": "@goobits/visibility-mode",
  "version": "0.1.0",
  "description": "Reusable release-stage / dev-target gating + switcher UI for SvelteKit sites",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "svelte": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    }
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
