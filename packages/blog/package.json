{
  "name": "@goobits/blog",
  "version": "2.0.0",
  "description": "Reusable blog components for Svelte 5 projects",
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "svelte": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./ui/elements": {
      "types": "./src/ui/elements/index.ts",
      "svelte": "./src/ui/elements/index.ts",
      "default": "./src/ui/elements/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "svelte": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/remark-table-of-contents": {
      "types": "./src/utils/remark-table-of-contents.d.ts",
      "default": "./src/utils/remark-table-of-contents.js"
    },
    "./utils/rehype-webp-picture": {
      "default": "./src/utils/rehype-webp-picture.js"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "svelte": "./src/config/index.ts",
      "default": "./src/config/index.ts"
    },
    "./config/defaults": {
      "types": "./src/config/defaults.ts",
      "svelte": "./src/config/defaults.ts",
      "default": "./src/config/defaults.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "svelte": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "UPGRADE.md"
  ],
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "blog",
    "markdown",
    "cms",
    "i18n",
    "internationalization",
    "typescript"
  ],
  "author": "GooBits",
  "homepage": "https://github.com/goobits/blog#readme",
  "bugs": {
    "url": "https://github.com/goobits/blog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goobits/blog.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^2.60.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
