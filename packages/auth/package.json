{
  "name": "@goobits/auth",
  "version": "0.2.0",
  "private": true,
  "description": "Authentication system for SvelteKit applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./adapters/database": "./dist/adapters/database/index.js",
    "./adapters/session": "./dist/adapters/session/index.js",
    "./adapters/oauth-token": "./dist/adapters/oauth-token/index.js",
    "./adapters/drizzle": "./dist/adapters/drizzle/index.js",
    "./adapters/verification-token": "./dist/adapters/verification-token/index.js",
    "./adapters/magic-link": "./dist/adapters/magic-link/index.js",
    "./adapters/webauthn": "./dist/adapters/webauthn/index.js",
    "./providers": "./dist/providers/index.js",
    "./handlers": "./dist/handlers/index.js",
    "./utils": "./dist/utils/index.js",
    "./client": "./dist/client/index.js",
    "./types": "./dist/types/index.js",
    "./testing": "./dist/testing/index.js",
    "./mfa": "./dist/mfa/index.js",
    "./security": "./dist/security/index.js",
    "./errors": "./dist/errors/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "drizzle-orm": "^0.44.0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
