{
  "name": "@goobits/sitemap",
  "version": "0.1.0",
  "description": "Reusable sitemap core and server helpers for SvelteKit sites",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
