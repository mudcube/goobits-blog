{
	"name": "@calendar/ui",
	"version": "0.0.0",
	"description": "Svelte components for the calendar admin + member UI.",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin/index.ts",
		"./admin/*": "./src/admin/*",
		"./booking": "./src/booking/index.ts",
		"./booking/*": "./src/booking/*",
		"./shared": "./src/shared/index.ts",
		"./shared/*": "./src/shared/*",
		"./member/*": "./src/member/*",
		"./api/*": "./src/api/*",
		"./routing/*": "./src/routing/*",
		"./config": "./src/config.ts"
	},
	"files": [
		"src",
		"tsconfig.json",
		"README.md"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@calendar/core": "workspace:*",
		"@lucide/svelte": "^1.14.0",
		"zod": "^4.4.3"
	}
}
