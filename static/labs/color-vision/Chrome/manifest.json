{
	"name": "Chrome Daltonize!",
	"version": "1.1",
	"description": "Daltonization is a technique of exposing details to color-blind users, allowing them see what they otherwise would have missed.",
	"icons": {
		"48": "media/sphere.png",
		"128": "media/sphere.png"
	},
	"permissions": ["http://*/*", "https://*/*"],
	"browser_action": {
		"default_icon": "media/favicon.png"
	},
	"options_page": "options.html",
	"background_page": "background.html",
	"content_scripts": [{
		"matches": ["http://*/*", "https://*/*"],
		"js": ["ColorData.js","content.js", "Color.Vision.Daltonize.js", "Color.Vision.Simulate.js" ],
		"run_at": "document_idle"
	}],
	"permissions": ["tabs", "http://*/*", "https://*/*"]
}