{
	"name": "zen-bg",
	"description": "Create beautiful backgrounds for websites or desktops",
	"version": "1.0.0",
	"pwaManifest": {
		"name": "Zen BG",
		"shortName": "Zen BG",
		"startURL": "./",
		"theme": "#add8e6",
		"generateIconOptions": {
			"baseIcon": "./static/media/logo.png",
			"sizes": [
				44,
				96,
				144,
				256,
				512
			],
			"genFavicons": true
		}
	},
	"scripts": {
		"build": "parcel build index.html --dist-dir ../../public/labs/zen-bg/ --no-source-maps --public-url ./",
		"build-and-serve": "yarn build; http-server ../../public/labs/zen-bg/ -p 1234",
		"dev": "parcel index.html"
	},
	"dependencies": {
		"@parcel/packager-raw-url": "2.13.2",
		"@parcel/packager-xml": "2.13.2",
		"@parcel/service-worker": "^2.13.2",
		"parcel": "^2.13.2",
		"parcel-config-pwa-manifest": "^0.1.6",
		"parcel-reporter-static-files-copy": "^1.5.3"
	},
	"browserslist": [
		"last 2 versions",
		"> 0.25%"
	]
}
