# Generated binary media should live in Git LFS. Keep the legacy static archive
# as normal Git blobs unless those files are intentionally migrated later.
static/media/generated/**/*.gif filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.jpg filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.m4a filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.ogg filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.png filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.wav filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.webm filter=lfs diff=lfs merge=lfs -text
static/media/generated/**/*.webp filter=lfs diff=lfs merge=lfs -text
