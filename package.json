{
	"name": "@goobits/blog",
	"version": "3.1.0",
	"description": "Reusable blog components for Svelte 5 projects",
	"main": "./src/index.ts",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@11.24.0",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./core": {
			"types": "./src/core/index.ts",
			"default": "./src/core/index.ts"
		},
		"./markdown": {
			"types": "./src/markdown/index.ts",
			"default": "./src/markdown/index.ts"
		},
		"./markdown/remark-table-of-contents": {
			"types": "./src/markdown/remarkTableOfContents.d.ts",
			"default": "./src/markdown/remarkTableOfContents.js"
		},
		"./markdown/rehype-webp-picture": {
			"types": "./src/markdown/rehypeWebpPicture.d.ts",
			"default": "./src/markdown/rehypeWebpPicture.js"
		},
		"./markdown/rehype-external-links": {
			"types": "./src/markdown/rehypeExternalLinks.d.ts",
			"default": "./src/markdown/rehypeExternalLinks.js"
		},
		"./sveltekit": {
			"types": "./src/sveltekit/index.ts",
			"default": "./src/sveltekit/index.ts"
		},
		"./ui": {
			"types": "./src/ui/index.ts",
			"svelte": "./src/ui/index.ts",
			"default": "./src/ui/index.ts"
		},
		"./ui/elements": {
			"types": "./src/ui/elements/index.ts",
			"svelte": "./src/ui/elements/index.ts",
			"default": "./src/ui/elements/index.ts"
		},
		"./ui/gallery-lightbox": {
			"types": "./src/ui/actions/galleryLightbox.ts",
			"default": "./src/ui/actions/galleryLightbox.ts"
		},
		"./config": {
			"types": "./src/config/index.ts",
			"default": "./src/config/index.ts"
		},
		"./ui/blogTheme.css": "./src/ui/blogTheme.css",
		"./i18n": {
			"types": "./src/i18n/index.ts",
			"svelte": "./src/i18n/index.ts",
			"default": "./src/i18n/index.ts"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"examples",
		"tsconfig.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"UPGRADE.md"
	],
	"license": "MIT",
	"type": "module",
	"peerDependencies": {
		"@goobits/forms": "^4.0.0",
		"@goobits/goo": ">=0.1.0",
		"@lucide/svelte": ">=1.16.0",
		"@sveltejs/kit": "^2.70.3",
		"svelte": "^5.56.10",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"dependencies": {
		"minisearch": "^7.2.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"blog",
		"markdown",
		"cms",
		"i18n",
		"internationalization",
		"typescript"
	],
	"author": "GooBits",
	"homepage": "https://github.com/goobits/blog#readme",
	"bugs": {
		"url": "https://github.com/goobits/blog/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/blog.git"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.33.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"eslint": "^10.9.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
