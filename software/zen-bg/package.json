{
	"name": "zen-bg",
	"description": "Create beautiful backgrounds for websites or desktops",
	"version": "1.0.0",
	"pwaManifest": {
		"name": "Zen BG",
		"shortName": "Zen BG",
		"startURL": "./",
		"theme": "#add8e6",
		"generateIconOptions": {
			"baseIcon": "./static/media/logo.png",
			"sizes": [
				44,
				96,
				144,
				256,
				512
			],
			"genFavicons": true
		}
	},
	"scripts": {
		"build": "parcel build index.html --dist-dir ../../public/labs/zen-bg/ --no-source-maps",
		"build-and-serve": "yarn build; http-server ../../public/labs/zen-bg/ -p 1234",
		"dev": "parcel index.html"
	},
	"dependencies": {
		"parcel": "^2.6.0",
		"parcel-config-pwa-manifest": "^0.1.2",
		"parcel-reporter-static-files-copy": "^1.3.4"
	},
	"devDependencies": {
		"@parcel/packager-raw-url": "2.6.0",
		"@parcel/packager-xml": "2.6.0"
	}
}