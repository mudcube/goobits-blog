{
	"name": "sketchpad-1.0",
	"description": "Sketchpad is an online drawing application",
	"version": "1.0.0",
	"pwaManifest": {
		"name": "Sketchpad 1.0",
		"shortName": "Sketchpad",
		"startURL": "./",
		"theme": "#add8e6",
		"generateIconOptions": {
			"baseIcon": "./static/media/gui/favicon.png",
			"sizes": [
				44,
				96,
				144,
				256,
				512
			],
			"genFavicons": true
		}
	},
	"scripts": {
		"build": "parcel build index.html --dist-dir ../../public/labs/sketchpad-1.0/ --no-source-maps --public-url ./",
		"build-and-serve": "yarn build; http-server ../../public/labs/sketchpad-1.0/ -p 1234",
		"dev": "parcel index.html"
	},
	"dependencies": {
		"@parcel/packager-raw-url": "2.6.0",
		"@parcel/packager-xml": "2.6.0",
		"@parcel/service-worker": "^2.5.0",
		"parcel": "^2.6.0",
		"parcel-config-pwa-manifest": "^0.1.2",
		"parcel-reporter-static-files-copy": "^1.3.4"
	},
	"browserslist": [
		"last 2 versions",
		"> 0.25%"
	]
}