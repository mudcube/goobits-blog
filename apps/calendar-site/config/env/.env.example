# Copy to .env and fill in values, then encrypt if this app adopts dotenvx.

# Server
PORT=3611
PUBLIC_BASE_URL=http://localhost:3611

# Calendar app admin/bootstrap
ADMIN_PASSCODE=

# Booking
BOOKING_LOCATION=
BOOKING_MIN_NOTICE_HOURS=24

# Media (R2)
MEDIA_PUBLIC_BASE=https://media.calendar.example.com

# Calendar provider sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3611/api/calendar/oauth-callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3611/auth/google/callback
GOOGLE_CALENDAR_IDS=primary
CALENDAR_SYNC_CRON_SECRET=
CALENDAR_SYNC_BASE_URL=http://localhost:3611
CALENDAR_SYNC_LIMIT=20

# Outlook Calendar Sync (optional)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3611/api/calendar/oauth-callback?provider=outlook
OUTLOOK_TENANT_ID=common
OUTLOOK_CALENDAR_ID=

# Member payments (optional)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SQUARE_ENVIRONMENT=sandbox
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=

# Encryption
TOKEN_ENC_KEY=

# Anti-abuse / registration
ANTIABUSE_ENABLED=true
ABUSE_MIN_SUBMIT_MS=2500
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=true
TURNSTILE_FAIL_OPEN=true
TURNSTILE_ENABLE_LOCALHOST=false
REGISTRATION_RATE_LIMIT_PER_IP=12
REGISTRATION_RATE_LIMIT_PER_EMAIL=5
REGISTRATION_RATE_LIMIT_PER_DEVICE=8
REGISTRATION_RATE_LIMIT_PER_ASN=30
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
DISPOSABLE_EMAIL_BLOCK_MODE=score
EMAIL_VERIFICATION_WEBHOOK_URL=
E2E_TEST_TOKEN=

# Apple Sign In (optional)
# APPLE_CLIENT_ID=
# APPLE_AUTH_REDIRECT_URI=http://localhost:3611/auth/apple/callback
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
