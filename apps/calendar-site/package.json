{
  "name": "@miko/calendar-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "pnpm exec svelte-kit sync && pnpm exec tsc --noEmit",
    "build": "pnpm exec svelte-kit sync && vite build",
    "dev": "vite dev --host 0.0.0.0 --port 3611"
  },
  "dependencies": {
    "@calendar/app": "workspace:*",
    "@calendar/core": "workspace:*",
    "@calendar/kit": "workspace:*",
    "@calendar/theme": "workspace:*",
    "@calendar/ui": "workspace:*",
    "@goobits/auth": "workspace:*",
    "@goobits/security": "workspace:*",
    "@goobits/ui": "workspace:*",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.55.7",
    "sveltekit-superforms": "^2.30.1",
    "vite": "^8.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0"
  }
}
