package{	import flash.display.Loader;	import flash.display.LoaderInfo;	import flash.display.Sprite;	import flash.display.Bitmap;	import flash.events.Event;	import flash.net.URLRequest;	import flash.external.ExternalInterface	import pixelbender.ColorBlindness;	import pixelbender.Daltonize;	public class Main extends Sprite{		public var defaults = { };		public function filterImage(vars):void{			for(var id in vars) {				defaults[id] = vars[id]; // record to defaults			}			// load image			var image  =  new URLRequest(defaults.src);			var loader  =  new Loader();			addChild(loader);			loader.load(image);			// run filters			switch(defaults.filter) {				case "Daltonize": 					var daltonize:Daltonize;					daltonize = new Daltonize();					daltonize.type = defaults.type;					daltonize.amount = defaults.amount;					this.filters = [daltonize];					break;				case "ColorBlindness": 					var colorblindness:ColorBlindness;					colorblindness = new ColorBlindness();					colorblindness.type = defaults.type;					colorblindness.amount = defaults.amount;					this.filters = [colorblindness];					break;				default: break;			}		}		public function Main():void{			this.loaderInfo.addEventListener(Event.COMPLETE, function(){				defaults.src = "images/Colored_Pencils.jpg";				defaults.amount = 1;				ExternalInterface.addCallback("filterImage", filterImage);				ExternalInterface.call("flashLoaded");			});		}	}}