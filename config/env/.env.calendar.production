# calendar-site production secrets
# Load with dotenvx and deploy to the calendar-site Cloudflare Pages project.

# Public/runtime base
PUBLIC_BASE_URL=https://pdx.fun
BASE_URL=https://pdx.fun

# Anti-abuse
PUBLIC_TURNSTILE_SITE_KEY=                                         # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY=                                              # Cloudflare Turnstile secret key
TURNSTILE_REQUIRED=true                                            # set false only for tests or controlled local debugging
TURNSTILE_FAIL_OPEN=false
TURNSTILE_ENABLE_LOCALHOST=false
ANTIABUSE_ENABLED=true
ABUSE_MIN_SUBMIT_MS=2500
REGISTRATION_RATE_LIMIT_PER_IP=12
REGISTRATION_RATE_LIMIT_PER_EMAIL=5
REGISTRATION_RATE_LIMIT_PER_DEVICE=8
REGISTRATION_RATE_LIMIT_PER_ASN=30
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
DISPOSABLE_EMAIL_BLOCK_MODE=warn

# Admin and cron
ADMIN_PASSCODE=                                                    # openssl rand -base64 16
ADMIN_BOOTSTRAP_EMAIL=hello@pdx.fun                                # first admin bootstrap email
CALENDAR_SYNC_CRON_SECRET=                                         # bearer token for /api/internal/calendar/sync
CALENDAR_SYNC_BASE_URL=https://pdx.fun
CALENDAR_SYNC_LIMIT=20

# Booking defaults
BOOKING_LOCATION=Portland, OR                                      # shown on booking confirmations
BOOKING_MIN_NOTICE_HOURS=24

# Google auth and calendar sync
GOOGLE_CLIENT_ID=                                                  # console.cloud.google.com → OAuth Client
GOOGLE_CLIENT_SECRET=                                              # same OAuth client page
GOOGLE_REDIRECT_URI=https://pdx.fun/api/calendar/oauth-callback     # calendar provider OAuth callback
GOOGLE_AUTH_REDIRECT_URI=https://pdx.fun/auth/google/callback
GOOGLE_CALENDAR_IDS=primary                                        # comma-separated calendar IDs

# Apple auth
APPLE_CLIENT_ID=                                                   # Apple Services ID
APPLE_TEAM_ID=                                                     # Apple developer team ID
APPLE_KEY_ID=                                                      # Apple private key ID
APPLE_PRIVATE_KEY=                                                 # Apple private key, escaped or multiline per dotenvx
APPLE_AUTH_REDIRECT_URI=https://pdx.fun/auth/apple/callback

# Token encryption
TOKEN_ENC_KEY=                                                     # openssl rand -base64 32

# Optional integrations
EMAIL_VERIFICATION_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
MEDIA_PUBLIC_BASE=https://media.pdx.fun
WEATHER_LAT=45.5152
WEATHER_LON=-122.6784

# Payments
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=live
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
