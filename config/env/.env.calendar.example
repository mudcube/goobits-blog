# Calendar-site local environment template

# Local URLs
PORT=3611
PUBLIC_BASE_URL=http://127.0.0.1:3611
BASE_URL=http://127.0.0.1:3611
DEV_DB_FILE=../../.dev/calendar-site.sqlite

# Admin
ADMIN_PASSCODE=
ADMIN_BOOTSTRAP_EMAIL=

# Booking defaults
BOOKING_LOCATION=
BOOKING_MIN_NOTICE_HOURS=24

# Google auth and calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3611/api/calendar/oauth-callback
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:3611/auth/google/callback
GOOGLE_CALENDAR_IDS=

# Apple auth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_AUTH_REDIRECT_URI=http://127.0.0.1:3611/auth/apple/callback

# Token encryption
TOKEN_ENC_KEY=

# Calendar sync
CALENDAR_SYNC_CRON_SECRET=
CALENDAR_SYNC_BASE_URL=http://127.0.0.1:3611
CALENDAR_SYNC_LIMIT=20

# Anti-abuse
ANTIABUSE_ENABLED=true
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=true
TURNSTILE_FAIL_OPEN=false
TURNSTILE_ENABLE_LOCALHOST=true
ABUSE_MIN_SUBMIT_MS=2500
REGISTRATION_RATE_LIMIT_PER_IP=12
REGISTRATION_RATE_LIMIT_PER_EMAIL=5
REGISTRATION_RATE_LIMIT_PER_DEVICE=8
REGISTRATION_RATE_LIMIT_PER_ASN=30
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
DISPOSABLE_EMAIL_BLOCK_MODE=warn

# Optional integrations
EMAIL_VERIFICATION_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEATHER_LAT=
WEATHER_LON=
MEDIA_PUBLIC_BASE=http://127.0.0.1:3611/media
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
