# Copy to .env and fill in values, then encrypt with: pnpm exec dotenvx encrypt -f config/env/.env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3610
PUBLIC_BASE_URL=http://localhost:3610                               # production: your public domain
PUBLIC_CALENDAR_SITE_URL=https://pdx.fun                            # target for legacy /schedule and /invite redirects
PUBLIC_CALENDAR_SITE_DEV_URL=http://127.0.0.1:3611                  # local split calendar app during development

# ── Anti-abuse / Contact ─────────────────────────────────────────────────────
ANTIABUSE_ENABLED=true
CONTACT_MIN_SUBMIT_MS=1500
CONTACT_WEBHOOK_URL=                                              # external email worker/webhook endpoint used by /api/email
CONTACT_SOURCE=your-site.example                                   # identifier sent with contact webhook payloads (site hostname or brand)
CONTACT_EVENT=contact-form                                         # event name sent with contact webhook payloads
CONTACT_FORM_PATH=/contact/                                        # path to the contact form page (used for non-JS redirects on error)
CONTACT_THANK_YOU_PATH=/contact/thank-you/                         # path users land on after a successful submission
PUBLIC_TURNSTILE_SITE_KEY=                                         # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY=                                              # Cloudflare Turnstile secret key
TURNSTILE_REQUIRED=true                                            # set false only for tests or controlled local debugging
TURNSTILE_FAIL_OPEN=true                                           # allow dev if secret missing
TURNSTILE_ENABLE_LOCALHOST=false                                  # render widget on localhost dev and bypass verification server-side
CONTACT_RATE_LIMIT_PER_IP=10
CONTACT_RATE_LIMIT_PER_EMAIL=3
CONTACT_RATE_LIMIT_PER_DEVICE=5
CONTACT_RATE_LIMIT_PER_ASN=20
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
