# Copy to .env and fill in values, then encrypt with: pnpm exec dotenvx encrypt -f config/env/.env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3610
PUBLIC_BASE_URL=http://localhost:3610                               # production: your public domain

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSCODE=                                                    # openssl rand -base64 16

# ── Booking ──────────────────────────────────────────────────────────────────
BOOKING_LOCATION=                                                  # shown on booking confirmations
BOOKING_MIN_NOTICE_HOURS=24

# ── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                                  # console.cloud.google.com → Credentials → OAuth Client
GOOGLE_CLIENT_SECRET=                                              # same OAuth client page
GOOGLE_REDIRECT_URI=http://localhost:3610/api/calendar/oauth-callback  # must match Authorized redirect URIs
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3610/auth/google/callback     # member sign-in callback (Goobits auth flow)
GOOGLE_CALENDAR_IDS=primary                                        # comma-separated calendar IDs
CALENDAR_SYNC_CRON_SECRET=                                         # bearer token for /api/internal/calendar/sync (can reuse ADMIN_PASSCODE)

# ── Outlook Calendar Sync (optional) ────────────────────────────────────────
OUTLOOK_CLIENT_ID=                                                 # Azure app registration client ID
OUTLOOK_CLIENT_SECRET=                                             # Azure app registration client secret
OUTLOOK_REDIRECT_URI=http://localhost:3610/api/calendar/oauth-callback?provider=outlook
OUTLOOK_TENANT_ID=common                                           # common|organizations|tenant id
OUTLOOK_CALENDAR_ID=                                               # optional; blank uses the signed-in user's default calendar

# ── Member Payments (optional) ──────────────────────────────────────────────
PAYPAL_ENVIRONMENT=sandbox                                        # sandbox|live
PAYPAL_CLIENT_ID=                                                 # PayPal REST app client ID; public JS SDK client id
PUBLIC_PAYPAL_CLIENT_ID=                                          # optional override for browser SDK, defaults to PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=                                             # PayPal REST app secret; server only
SQUARE_ENVIRONMENT=sandbox                                        # sandbox|live
PUBLIC_SQUARE_APPLICATION_ID=                                     # Square Web Payments app id
PUBLIC_SQUARE_LOCATION_ID=                                        # Square location id for browser SDK
SQUARE_LOCATION_ID=                                               # optional server override, defaults to PUBLIC_SQUARE_LOCATION_ID
SQUARE_ACCESS_TOKEN=                                              # Square access token; server only

# ── Encryption ───────────────────────────────────────────────────────────────
TOKEN_ENC_KEY=                                                     # openssl rand -base64 32

# ── Anti-abuse / Register ────────────────────────────────────────────────────
ANTIABUSE_ENABLED=true
ABUSE_MIN_SUBMIT_MS=2500
CONTACT_WEBHOOK_URL=                                              # external email worker/webhook endpoint used by /api/email
PUBLIC_TURNSTILE_SITE_KEY=                                         # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY=                                              # Cloudflare Turnstile secret key
TURNSTILE_REQUIRED=true                                            # set false only for tests or controlled local debugging
TURNSTILE_FAIL_OPEN=true                                           # allow dev if secret missing
TURNSTILE_ENABLE_LOCALHOST=false                                  # render widget on localhost dev and bypass verification server-side
REGISTRATION_RATE_LIMIT_PER_IP=12
REGISTRATION_RATE_LIMIT_PER_EMAIL=5
REGISTRATION_RATE_LIMIT_PER_DEVICE=8
REGISTRATION_RATE_LIMIT_PER_ASN=30
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
DISPOSABLE_EMAIL_BLOCK_MODE=score                                 # off|score|block
EMAIL_VERIFICATION_WEBHOOK_URL=                                    # optional webhook for verification email sending
E2E_TEST_TOKEN=                                                    # optional dev-only token for /api/test/calendar-session

# ── Apple Sign In (optional) ─────────────────────────────────────────────────
# APPLE_CLIENT_ID=                                                 # developer.apple.com → Services ID
# APPLE_AUTH_REDIRECT_URI=http://localhost:3610/auth/apple/callback      # member sign-in callback (Goobits auth flow)
# APPLE_TEAM_ID=                                                   # developer.apple.com → Membership
# APPLE_KEY_ID=                                                    # developer.apple.com → Keys
# APPLE_PRIVATE_KEY=                                               # .p8 file contents, \n-escaped
