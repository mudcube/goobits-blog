# Production secrets — encrypt with: pnpm exec dotenvx encrypt -f config/env/.env.production
# Deploy to Cloudflare with: pnpm deploy:secrets

# ── Server ───────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=                                                   # your production domain
CONTACT_WEBHOOK_URL=                                               # external email worker/webhook endpoint used by /api/email
CONTACT_SOURCE=miko.art                                            # identifier sent with contact webhook payloads
CONTACT_EVENT=miko-contact-form                                    # event name sent with contact webhook payloads
CONTACT_FORM_PATH=/contact/                                        # path to the contact form page
CONTACT_THANK_YOU_PATH=/contact/thank-you/                         # path users land on after a successful submission
PUBLIC_TURNSTILE_SITE_KEY=                                         # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY=                                              # Cloudflare Turnstile secret key
TURNSTILE_REQUIRED=true                                            # set false only for tests or controlled local debugging

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSCODE=                                                    # openssl rand -base64 16
CALENDAR_SYNC_CRON_SECRET=                                         # bearer token for /api/internal/calendar/sync

# ── Booking ──────────────────────────────────────────────────────────────────
BOOKING_LOCATION=                                                  # shown on booking confirmations
BOOKING_MIN_NOTICE_HOURS=24

# ── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                                  # console.cloud.google.com → OAuth Client
GOOGLE_CLIENT_SECRET=                                              # same OAuth client page
GOOGLE_REDIRECT_URI=                                               # production callback URL
GOOGLE_CALENDAR_IDS=primary                                        # comma-separated calendar IDs

# ── Encryption ───────────────────────────────────────────────────────────────
TOKEN_ENC_KEY=                                                     # openssl rand -base64 32

# ── Apple Sign In (optional) ─────────────────────────────────────────────────
# APPLE_CLIENT_ID=                                                 # developer.apple.com → Services ID
# APPLE_TEAM_ID=                                                   # developer.apple.com → Membership
# APPLE_KEY_ID=                                                    # developer.apple.com → Keys
# APPLE_PRIVATE_KEY=                                               # .p8 file contents, \n-escaped
